tower.enabled = false

params {
  input = 'samplesheet.csv'
  outdir = 'results'
  ambient_correction = 'decontx'
  doublet_detection = 'scrublet'
  integration_methods = "scvi,scanvi"
  clustering_resolutions = "0.5,1.0,1.5,2.0"
  memory_scale = 2
  prep_cellxgene = true
  force_obs_cols = 'sample,modality'
  integration_hvgs = 0
  unify_gene_symbols = true
  duplicate_var_resolution = 'sum'
  scvi_categorical_covariates = 'modality'

}

process {
  maxRetries = 5
  cache = 'lenient'

  // DEFAULT for CPU jobs:
  queue = 'exbio-cpu'                 // or 'shared-cpu' if you prefer
  clusterOptions = '--qos=daisybio'   // important: avoid limitgpus on CPU partitions

  withName: 'ADATA_MERGE' {
    executor = 'local'
  }

  withName: '.*:SCANPY_(SCRUBLET|HVGS|HARMONY|NEIGHBORS|LEIDEN|UMAP|RANKGENESGROUPS)' {
    queue = 'shared-cpu'
    ext.use_gpu = false
    clusterOptions = '--qos=daisybio'   // or '' if QoS is automatically set
  }

  // ONLY GPU-labeled processes get GPU QoS + GPU resources:
  withLabel: process_gpu {
    queue = 'shared-gpu'
    clusterOptions = '--qos=limitgpus --gpus=a40:1'
  }
}