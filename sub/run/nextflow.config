tower.enabled = false
nextflow.enable.dsl = 2

def BASE = "/nfs/scratch/nf-core_work/${System.getenv('USER')}/manual_subatlas"

workDir = "${BASE}/work"
cleanup = false

env {
  APPTAINER_TMPDIR   = "${BASE}/apptainer_tmp"
  APPTAINER_CACHEDIR = "${BASE}/apptainer_cache"
  TMPDIR             = "${BASE}/apptainer_tmp"
}

apptainer {
  enabled    = true
  autoMounts = true
  runOptions = "--nv --pwd /tmp"
  cacheDir   = "${BASE}/apptainer_cache"
  libraryDir = "${BASE}/apptainer_library"
}

process {
  executor   = 'slurm'
  cache      = 'lenient'
  maxRetries = 3

  queue          = 'exbio-cpu'
  clusterOptions = '--qos=daisybio'
  cpus           = 16
  memory         = '80 GB'
  time           = '24h'

  shell = ['/bin/bash', '-ue']

  beforeScript = '''
    if [ -z "${APPTAINER_NAME:-}" ] && [ -z "${SINGULARITY_NAME:-}" ]; then
      set +u
      source ~/.bashrc
      conda activate hugo_unify
      set -u
    fi
  '''
}

process {
  withLabel: process_gpu {
    queue          = 'shared-gpu'
    clusterOptions = '--qos=limitgpus --gpus=a40:1'
  }
}